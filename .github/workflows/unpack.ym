name: Install JARVIS files

on:

  workflow_dispatch:

  push:

    paths:

      - "JARVIS-V0.3-ready.zip"

permissions:

  contents: write

jobs:

  unpack:

    runs-on: ubuntu-latest

    steps:

      - name: Checkout

        uses: actions/checkout@v4

      - name: Extract JARVIS

        run: |

          rm -rf /tmp/jarvis

          mkdir -p /tmp/jarvis

          unzip -o JARVIS-V0.3-ready.zip -d /tmp/jarvis

          cp -R /tmp/jarvis/JARVIS-V0.3/* .

          rm -f JARVIS-V0.3-ready.zip

      - name: Commit JARVIS

        run: |

          git config user.name "JARVIS Builder"

          git config user.email "actions@github.com"

          git add -A

          if git diff --cached --quiet; then

            echo "Nothing to commit"

            exit 0

          fi

          git commit -m "Deploy JARVIS V0.3 files"

          git push
